# Only publish the compact deploy copy of data, never raw CSV / ZIP.
__pycache__/
*.pyc
*.csv
*.zip
*.tar.gz
*.tmp
.env
.venv/
.ipynb_checkpoints/
.streamlit/secrets.toml
# Raw downloads (e.g. SteamDB chart exports) stay local; only processed/ is published.
data/raw/
*.xls
.DS_Store
backup_before_extension_*/

# Team-reviewed game details (an exception to the *.csv rule above).
!data/game_info.csv
